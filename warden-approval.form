{
  "components": [
    {
      "text": "# Out-pass request\n\n**Student:** {{studentName}} ({{regNo}})\n\n**Block:** {{hostelBlock}}\n\n**Out date:** {{outDate}}  |  **Return date:** {{returnDate}}\n\n**Nights:** {{nights}}\n\n**Purpose:** {{purpose}}\n\n**Parent phone:** {{parentPhone}}",
      "type": "text",
      "id": "Field_info"
    },
    {
      "label": "Approve this out-pass",
      "type": "checkbox",
      "id": "Field_approved",
      "key": "approved"
    },
    {
      "label": "Warden remarks",
      "type": "textarea",
      "id": "Field_remarks",
      "key": "wardenRemarks"
    }
  ],
  "type": "default",
  "id": "warden-approval-form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "schemaVersion": 16
}
