<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_booking" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:message id="Message_Cancel" name="cancel-booking">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="appointment-booking" name="Appointment Booking" isExecutable="true">
    <bpmn:startEvent id="Start_1" name="Booking requested">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Check" name="Check slot">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Slot" name="Slot available?" default="F_Full">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_Avail</bpmn:outgoing>
      <bpmn:outgoing>F_Full</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Book" name="Book slot">
      <bpmn:extensionElements>
        <zeebe:script expression="=&quot;BK-&quot; + patientId + &quot;-&quot; + preferredSlot" resultVariable="bookingRef" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Avail</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="Call_Confirm" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="recipientId" />
          <zeebe:input source="=&quot;Hello &quot; + patientName + &quot;, your &quot; + department + &quot; appointment is confirmed for &quot; + preferredSlot + &quot;. Ref: &quot; + bookingRef" target="messageText" />
          <zeebe:output source="=telegramResponse" target="confirmationResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_Attend" name="Attend appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Done" name="Appointment completed">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_Full" name="Send slot-full notice">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="recipientId" />
          <zeebe:input source="=&quot;Sorry &quot; + patientName + &quot;, the &quot; + department + &quot; slot is full. &quot; + slotDecision.suggestedAction" target="messageText" />
          <zeebe:output source="=telegramResponse" target="slotFullResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Full</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_Full" name="Slot full">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Cancel" name="Handle cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Start_Cancel" name="Cancellation received" isInterrupting="true">
        <bpmn:outgoing>C1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Cancel" messageRef="Message_Cancel" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_Release" name="Release slot">
        <bpmn:extensionElements>
          <zeebe:script expression="=&quot;RELEASED &quot; + bookingRef" resultVariable="releaseStatus" />
        </bpmn:extensionElements>
        <bpmn:incoming>C1</bpmn:incoming>
        <bpmn:outgoing>C2</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="Call_Cancel" name="Send cancellation notice">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=patientId" target="recipientId" />
            <zeebe:input source="=&quot;Hello &quot; + patientName + &quot;, your &quot; + department + &quot; appointment on &quot; + preferredSlot + &quot; is cancelled and the slot is released.&quot;" target="messageText" />
            <zeebe:output source="=telegramResponse" target="cancelResponse" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>C2</bpmn:incoming>
        <bpmn:outgoing>C3</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="End_Cancel" name="Booking cancelled">
        <bpmn:incoming>C3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="C1" sourceRef="Start_Cancel" targetRef="Task_Release" />
      <bpmn:sequenceFlow id="C2" sourceRef="Task_Release" targetRef="Call_Cancel" />
      <bpmn:sequenceFlow id="C3" sourceRef="Call_Cancel" targetRef="End_Cancel" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Check" targetRef="GW_Slot" />
    <bpmn:sequenceFlow id="F_Avail" name="AVAILABLE" sourceRef="GW_Slot" targetRef="Task_Book">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotDecision.slotStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Full" name="FULL (default)" sourceRef="GW_Slot" targetRef="Call_Full" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Book" targetRef="Call_Confirm" />
    <bpmn:sequenceFlow id="F4" sourceRef="Call_Confirm" targetRef="Task_Attend" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Attend" targetRef="End_Done" />
    <bpmn:sequenceFlow id="F6" sourceRef="Call_Full" targetRef="End_Full" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="appointment-booking">
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start_1">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Check" bpmnElement="Task_Check">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW" bpmnElement="GW_Slot" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="382" y="145" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Book" bpmnElement="Task_Book">
        <dc:Bounds x="500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Confirm" bpmnElement="Call_Confirm" isExpanded="false">
        <dc:Bounds x="650" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Attend" bpmnElement="Task_Attend">
        <dc:Bounds x="800" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Done" bpmnElement="End_Done">
        <dc:Bounds x="952" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="930" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CallFull" bpmnElement="Call_Full" isExpanded="false">
        <dc:Bounds x="500" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndFull" bpmnElement="End_Full">
        <dc:Bounds x="662" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="656" y="355" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Sub" bpmnElement="Sub_Cancel" isExpanded="true">
        <dc:Bounds x="160" y="430" width="560" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_StartC" bpmnElement="Start_Cancel">
        <dc:Bounds x="200" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="180" y="555" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Release" bpmnElement="Task_Release">
        <dc:Bounds x="290" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CallCancel" bpmnElement="Call_Cancel" isExpanded="false">
        <dc:Bounds x="440" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndC" bpmnElement="End_Cancel">
        <dc:Bounds x="602" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="580" y="555" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F1"><di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2"><di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Avail" bpmnElement="F_Avail">
        <di:waypoint x="445" y="200" /><di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="437" y="182" width="64" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Full" bpmnElement="F_Full">
        <di:waypoint x="420" y="225" /><di:waypoint x="420" y="330" /><di:waypoint x="500" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="270" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3"><di:waypoint x="600" y="200" /><di:waypoint x="650" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4"><di:waypoint x="750" y="200" /><di:waypoint x="800" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5"><di:waypoint x="900" y="200" /><di:waypoint x="952" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6"><di:waypoint x="600" y="330" /><di:waypoint x="662" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EC1" bpmnElement="C1"><di:waypoint x="236" y="530" /><di:waypoint x="290" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EC2" bpmnElement="C2"><di:waypoint x="390" y="530" /><di:waypoint x="440" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EC3" bpmnElement="C3"><di:waypoint x="540" y="530" /><di:waypoint x="602" y="530" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
